[application]
config/name="StudyTown"
run/main_scene="res://scenes/main/main.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
boot_splash/bg_color=Color(0.055, 0.043, 0.035, 1)
boot_splash/show_image=false

[autoload]
GameState="*res://autoload/game_state.gd"
FocusManager="*res://autoload/focus_manager.gd"

[display]
window/size/viewport_width=1280
window/size/viewport_height=720
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="canvas_items"

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/default_filters/use_nearest_mipmap_filter=false
environment/defaults/default_clear_color=Color(0.055, 0.043, 0.035, 1)

[input]
move_forward={"deadzone":0.2,"events":[Object(InputEventKey,"physical_keycode":87)]}
move_back={"deadzone":0.2,"events":[Object(InputEventKey,"physical_keycode":83)]}
move_left={"deadzone":0.2,"events":[Object(InputEventKey,"physical_keycode":65)]}
move_right={"deadzone":0.2,"events":[Object(InputEventKey,"physical_keycode":68)]}
interact={"deadzone":0.2,"events":[Object(InputEventKey,"physical_keycode":69)]}
wave={"deadzone":0.2,"events":[Object(InputEventKey,"physical_keycode":70)]}
menu={"deadzone":0.2,"events":[Object(InputEventKey,"physical_keycode":4194305)]}
debug_spots={"deadzone":0.2,"events":[Object(InputEventKey,"physical_keycode":4194334)]}
debug_collision={"deadzone":0.2,"events":[Object(InputEventKey,"physical_keycode":4194335)]}
debug_focus={"deadzone":0.2,"events":[Object(InputEventKey,"physical_keycode":4194336)]}
debug_overlay={"deadzone":0.2,"events":[Object(InputEventKey,"physical_keycode":4194337)]}

[layer_names]
3d_physics/layer_1="World"
3d_physics/layer_2="Player"
3d_physics/layer_3="NPC"
3d_physics/layer_4="Interaction"
3d_physics/layer_5="CameraOccluder"
